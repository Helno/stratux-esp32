# Radio configuration: Bluetooth Low Energy (BLE) for traffic transmission.
# NMEA/FLARM output via BLE GATT (0xffe0/0xffe1 SoftRF UUIDs).
# Compatible with XCSoar, SeeYou, and other FLARM-aware EFBs.
# WiFi disabled to free DRAM for BLE stack (original ESP32 constraint).

# --- WiFi OFF (BLE-only to maximize DRAM headroom) ---
CONFIG_ESP_WIFI_ENABLED=n

# --- Bluetooth Low Energy ON (BLE-only, no BR/EDR) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_SPP_ENABLED=n
# BLE-only mode (no dual-stack)
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n

# --- DRAM Optimization ---
# Reduce WiFi/network buffers (not used without WiFi)
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=4
CONFIG_LWIP_MAX_SOCKETS=4
CONFIG_LWIP_TCP_MSS=1024
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2048
CONFIG_LWIP_TCP_WND_DEFAULT=2048

# Reduce HTTP server (not critical for BLE)
CONFIG_HTTPD_MAX_URI_HANDLERS=16

# Reduce BLE MTU for traffic (NMEA strings are small)
CONFIG_BT_BLE_MSS=64

# Reduce console input buffer
CONFIG_CONSOLE_INPUT_BUF_SIZE=256
