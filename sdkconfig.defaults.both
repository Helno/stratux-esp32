# Radio configuration: WiFi SoftAP (GDL90) + BLE (NMEA/FLARM GATT) together.
# Intended for ESP32-S3 (PSRAM); the original ESP32 lacks the DRAM for both.
# Layered on sdkconfig.defaults via `-D RADIO=both`.

CONFIG_ESP_WIFI_ENABLED=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
# nmea_ble uses the legacy 4.2 advertising API; the S3 defaults to 5.0 only
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_SPP_ENABLED=n

# Needed so WiFi and BLE can share the 2.4 GHz radio
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
